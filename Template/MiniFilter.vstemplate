<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <TemplateID>Community.Cpp.Driver.FileSystemMiniFilter</TemplateID>
    <Name>Filter Driver: Filesystem Mini-filter</Name>
    <Description>A basic file system mini-filter driver project that uses the Filter Manager (fltmgr). Builds Universal drivers by default.</Description>
    <ProjectType>VC</ProjectType>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>1000</SortOrder>
    <NumberOfParentCategoriesToRollUp>1</NumberOfParentCategoriesToRollUp>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>MiniFilter</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.ico</Icon>
    <PromptForSaveOnCreation>true</PromptForSaveOnCreation>
    <LanguageTag>Cpp</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Driver</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$projectname$.vcxproj" File="MiniFilter.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="$projectname$.vcxproj.filters">MiniFilter.vcxproj.filters</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.cpp" OpenInEditor="true">MiniFilter.cpp</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.inf">MiniFilter.inf</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.rc">MiniFilter.rc</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
