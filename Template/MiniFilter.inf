;;;
;;; $safeprojectname$
;;;
;;; File system mini-filter driver INF.
;;;
;;; Install  : right-click this INF -> "Install", or
;;;            RUNDLL32.EXE SETUPAPI.DLL,InstallHinfSection DefaultInstall 132 <path>\$safeprojectname$.inf
;;; Load     : fltmc load $safeprojectname$
;;; Unload   : fltmc unload $safeprojectname$
;;;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"                         ; TODO: Class must match the LoadOrderGroup below
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}    ; TODO: ClassGuid must match the Class above
Provider    = %ManufacturerName%
DriverVer   =                                           ; Stamped by StampInf at build time
CatalogFile = $safeprojectname$.cat
PnpLockdown = 1

[SourceDisksFiles]
$safeprojectname$.sys = 1,,

[SourceDisksNames]
1 = %DiskName%,,,

[DestinationDirs]
MiniFilterDownlevel.CopyDriverFiles = 12            ; %windir%\system32\drivers
MiniFilterDownlevel.DelDriverFiles  = 12            ; %windir%\system32\drivers
MiniFilter.DriverFiles              = 13            ; Driver store

;;
;; Default install sections (Windows build 25952 and later: run from the driver store)
;;

[DefaultInstall.NT$ARCH$.10.0...25952]
OptionDesc = %ServiceDescription%
CopyFiles  = MiniFilter.DriverFiles

[DefaultInstall.NT$ARCH$.10.0...25952.Services]
AddService = %ServiceName%,,MiniFilter.Service

[MiniFilter.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %13%\%DriverName%.sys           ; Driver store
Dependencies   = "FltMgr"
ServiceType    = 2                               ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 3                               ; SERVICE_DEMAND_START
ErrorControl   = 1                               ; SERVICE_ERROR_NORMAL
LoadOrderGroup = "FSFilter Activity Monitor"     ; TODO: Must match the Class above
AddReg         = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Parameters\Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[MiniFilter.DriverFiles]
%DriverName%.sys

;;
;; Downlevel default install sections (Windows builds earlier than 25952)
;;

[DefaultInstall.NT$ARCH$]
OptionDesc = %ServiceDescription%
CopyFiles  = MiniFilterDownlevel.CopyDriverFiles

[DefaultInstall.NT$ARCH$.Services]
AddService = %ServiceName%,,MiniFilterDownlevel.Service

[DefaultUninstall.NT$ARCH$]
LegacyUninstall = 1
DelFiles        = MiniFilterDownlevel.DelDriverFiles

[DefaultUninstall.NT$ARCH$.Services]
DelService = %ServiceName%,0x200                 ; Ensure the service is stopped before deleting

[MiniFilterDownlevel.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %12%\%DriverName%.sys           ; %windir%\system32\drivers
Dependencies   = "FltMgr"
ServiceType    = 2                               ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 3                               ; SERVICE_DEMAND_START
ErrorControl   = 1                               ; SERVICE_ERROR_NORMAL
LoadOrderGroup = "FSFilter Activity Monitor"     ; TODO: Must match the Class above
AddReg         = MiniFilterDownlevel.AddRegistry

[MiniFilterDownlevel.AddRegistry]
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[MiniFilterDownlevel.CopyDriverFiles]
%DriverName%.sys

[MiniFilterDownlevel.DelDriverFiles]
%DriverName%.sys

;;
;; Strings
;;

[Strings]
ManufacturerName   = "<Your manufacturer name>"      ; TODO: Replace with your manufacturer name
DiskName           = "$safeprojectname$ Installation Disk"
ServiceName        = "$safeprojectname$"
ServiceDescription = "$safeprojectname$ Mini-Filter Driver"
DriverName         = "$safeprojectname$"

; Instance specific information
DefaultInstance    = "$safeprojectname$ Instance"
Instance1.Name     = "$safeprojectname$ Instance"
Instance1.Altitude = "370000"                        ; TODO: Request an altitude from Microsoft for production use
Instance1.Flags    = 0x0                             ; 0x0 = allow automatic and manual attachments
